{"config":{"lang":["ru"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u044b","text":"<p>\u0421\u0442\u0443\u0434\u0435\u043d\u0442: Govorov Pavel</p> <p>\u0413\u0440\u0443\u043f\u043f\u0430: K3340</p>"},{"location":"#_2","title":"\u0420\u0430\u0431\u043e\u0442\u044b","text":"<ul> <li>\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 1 \u2014 \u0420\u0430\u0431\u043e\u0442\u0430 \u0441 \u0441\u043e\u043a\u0435\u0442\u0430\u043c\u0438</li> </ul>"},{"location":"lr1/report/","title":"\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u21161. \u0420\u0430\u0431\u043e\u0442\u0430 \u0441 \u0441\u043e\u043a\u0435\u0442\u0430\u043c\u0438","text":"<p>\u0421\u0442\u0443\u0434\u0435\u043d\u0442: Govorov Pavel</p> <p>\u0413\u0440\u0443\u043f\u043f\u0430: K3340</p> <p>\u0412\u0430\u0440\u0438\u0430\u043d\u0442: 1</p>"},{"location":"lr1/report/#_1","title":"\u0426\u0435\u043b\u044c \u0440\u0430\u0431\u043e\u0442\u044b","text":"<p>\u041e\u0441\u0432\u043e\u0438\u0442\u044c \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0435 \u043a\u043b\u0438\u0435\u043d\u0442\u0441\u043a\u0438\u0445 \u0438 \u0441\u0435\u0440\u0432\u0435\u0440\u043d\u044b\u0445 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439 \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c <code>socket</code>, \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u043e\u0432 UDP \u0438 TCP, HTTP-\u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432 \u0438 \u043c\u043d\u043e\u0433\u043e\u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u0438.</p> <p>\u0418\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u043a\u043e\u0434 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 <code>students/k3340/laboratory_works/Govorov_Pavel/laboratory_work_1/</code>.</p>"},{"location":"lr1/report/#1-udp-","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 1. UDP-\u043e\u0431\u043c\u0435\u043d","text":"<p>\u041a\u043b\u0438\u0435\u043d\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u0435\u0440\u0432\u0435\u0440\u0443 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 <code>Hello, server</code>, \u0441\u0435\u0440\u0432\u0435\u0440 \u0432\u044b\u0432\u043e\u0434\u0438\u0442 \u0435\u0433\u043e \u0438 \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 <code>Hello, client</code>. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f UDP-\u0441\u043e\u043a\u0435\u0442 <code>AF_INET</code> \u0438 <code>SOCK_DGRAM</code>.</p> <pre><code># client.py\nclient.sendto(b\"Hello, server\", (\"127.0.0.1\", 5001))\ndata, _ = client.recvfrom(1024)\n\n# server.py\nmessage, address = server.recvfrom(1024)\nprint(message.decode())\nserver.sendto(b\"Hello, client\", address)\n</code></pre> <p>\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430:</p> <pre><code>python task_1/server.py\npython task_1/client.py\nHello, server\nHello, client\n</code></pre> <p></p> <p></p>"},{"location":"lr1/report/#2-tcp-","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 2. TCP-\u0432\u044b\u0447\u0438\u0441\u043b\u0435\u043d\u0438\u044f","text":"<p>\u0414\u043b\u044f \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430 1 \u0441\u0435\u0440\u0432\u0435\u0440 \u0432\u044b\u0447\u0438\u0441\u043b\u044f\u0435\u0442 \u0433\u0438\u043f\u043e\u0442\u0435\u043d\u0443\u0437\u0443 \u043f\u043e \u0442\u0435\u043e\u0440\u0435\u043c\u0435 \u041f\u0438\u0444\u0430\u0433\u043e\u0440\u0430: <code>c = \u221a(a\u00b2 + b\u00b2)</code>.</p> <pre><code>a, b = map(float, connection.recv(1024).decode().split())\nconnection.sendall(str((a * a + b * b) ** 0.5).encode())\n</code></pre> <p>\u041a\u043b\u0438\u0435\u043d\u0442 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0434\u0432\u0430 \u043a\u0430\u0442\u0435\u0442\u0430 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u043e\u0439 \u043f\u043e TCP \u0438 \u0432\u044b\u0432\u043e\u0434\u0438\u0442 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442.</p> <pre><code>python task_2/server.py\npython task_2/client.py\n\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043f\u0435\u0440\u0432\u044b\u0439 \u043a\u0430\u0442\u0435\u0442: 3\n\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0432\u0442\u043e\u0440\u043e\u0439 \u043a\u0430\u0442\u0435\u0442: 4\n\u0413\u0438\u043f\u043e\u0442\u0435\u043d\u0443\u0437\u0430: 5.0\n</code></pre> <p></p> <p></p>"},{"location":"lr1/report/#3-http-","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 3. HTTP-\u0441\u0435\u0440\u0432\u0435\u0440","text":"<p>\u0421\u0435\u0440\u0432\u0435\u0440 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 TCP-\u0441\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u0435 \u043d\u0430 \u043f\u043e\u0440\u0442\u0443 <code>8080</code>, \u0447\u0438\u0442\u0430\u0435\u0442 <code>index.html</code> \u0438 \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u0444\u043e\u0440\u043c\u0438\u0440\u0443\u0435\u0442 HTTP-\u043e\u0442\u0432\u0435\u0442 \u0441 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0430\u043c\u0438 <code>Content-Type</code> \u0438 <code>Content-Length</code>.</p> <pre><code>response = (\n    b\"HTTP/1.1 200 OK\\r\\n\"\n    b\"Content-Type: text/html; charset=utf-8\\r\\n\"\n    + f\"Content-Length: {len(html)}\\r\\n\\r\\n\".encode()\n    + html\n)\nconnection.sendall(response)\n</code></pre> <p>\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435 \u043f\u043e \u0430\u0434\u0440\u0435\u0441\u0443 <code>http://127.0.0.1:8080/</code>.</p> <p></p>"},{"location":"lr1/report/#4","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 4. \u041c\u043d\u043e\u0433\u043e\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0438\u0439 \u0447\u0430\u0442","text":"<p>\u0427\u0430\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 TCP \u0438 \u0441\u043e\u0437\u0434\u0430\u0451\u0442 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0442\u043e\u043a <code>threading.Thread</code> \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430. \u041f\u0440\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u043a\u043b\u0438\u0435\u043d\u0442 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0438\u043c\u044f. \u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043e\u0441\u0442\u0430\u043b\u044c\u043d\u044b\u043c \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u0430\u043c. \u041a\u043e\u043c\u0430\u043d\u0434\u0430 <code>/quit</code> \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435.</p> <pre><code>connection, _ = server.accept()\nthreading.Thread(target=handle_client, args=(connection,)).start()\n</code></pre> <p>\u0412 \u043a\u043b\u0438\u0435\u043d\u0442\u0435 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0442\u043e\u043a \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u0432\u043e\u0434 \u0438 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0442 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e.</p> <pre><code>python task_4/server.py\npython task_4/client.py\n</code></pre> <p>\u041a\u043b\u0438\u0435\u043d\u0442 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u0432 \u0434\u0432\u0443\u0445 \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435 \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430\u0445.</p> <p></p> <p></p> <p></p>"},{"location":"lr1/report/#5-","title":"\u0417\u0430\u0434\u0430\u043d\u0438\u0435 5. \u0412\u0435\u0431-\u0441\u0435\u0440\u0432\u0435\u0440 \u043e\u0446\u0435\u043d\u043e\u043a","text":"<p>\u0421\u0435\u0440\u0432\u0435\u0440 \u043d\u0430 \u043f\u043e\u0440\u0442\u0443 <code>8085</code> \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0435\u0442 GET \u0438 POST-\u0437\u0430\u043f\u0440\u043e\u0441\u044b. POST \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0434\u0438\u0441\u0446\u0438\u043f\u043b\u0438\u043d\u044b \u0438 \u043e\u0446\u0435\u043d\u043a\u0443, \u0430 GET \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0444\u043e\u0440\u043c\u0443 \u0438 \u0442\u0430\u0431\u043b\u0438\u0446\u0443. \u041e\u0446\u0435\u043d\u043a\u0438 \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u0443\u044e\u0442\u0441\u044f \u043f\u043e \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u0443.</p> <pre><code>data = parse_qs(request.split(\"\\r\\n\\r\\n\", 1)[1])\nsubject = data[\"subject\"][0]\ngrades.setdefault(subject, []).append(data[\"grade\"][0])\n</code></pre> <p>\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0435:</p> <pre><code>python task_5/server.py\nhttp://127.0.0.1:8085/\n</code></pre> <p></p> <p>\u0414\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0432\u0441\u0435\u0445 \u043a\u043e\u043c\u0430\u043d\u0434 \u043d\u0443\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u0439\u0442\u0438 \u0432 \u043f\u0430\u043f\u043a\u0443 \u0440\u0430\u0431\u043e\u0442\u044b:</p> <pre><code>cd students/k3340/laboratory_works/Govorov_Pavel/laboratory_work_1\n</code></pre>"}]}